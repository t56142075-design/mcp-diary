# =========================================================
# MCP 双人日记 环境变量示例
# 复制为 .env 后填写真实值，.env 已被 .gitignore 忽略，绝不提交
# =========================================================

# 数据目录：三个 SQLite 库与密钥文件的存放位置
# user_private.db / ai_private.db / shared.db 都在这里
DIARY_DATA_DIR=./data

# 用户私密区加密口令（用户端 CLI 启动时使用）
# 留空则 CLI 每次启动时交互式询问
# 口令经 scrypt 派生为 AES-256 密钥，口令本身不落盘
DIARY_USER_PASSPHRASE=

# AI 私密区密钥文件路径（由 MCP Server 首次启动时自动生成并保管）
# 用户端 CLI 不读取此文件
DIARY_AI_KEY_FILE=./data/keys/ai_private.key

# ===== 以下仅 ChatGPT 等远程客户端接入时需要 =====
# Bearer 令牌：设置后 server 以 streamable HTTP 模式运行（不设置则保持 stdio）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 远程客户端（ChatGPT 连接器）请求头需携带 Authorization: Bearer <此值>
DIARY_HTTP_TOKEN=

# HTTP 监听地址与端口（默认只监听本机回环，由隧道进程转发）
DIARY_HTTP_HOST=127.0.0.1
DIARY_HTTP_PORT=8080

# Host 头白名单（逗号分隔，如 *.trycloudflare.com 隧道域名）
# 留空则关闭 Host 校验（Bearer 令牌鉴权已兜底）
DIARY_ALLOWED_HOSTS=
